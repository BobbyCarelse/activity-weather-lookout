PORT=4000

# Applies to every request, keyed by client IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Open-Meteo's free tier needs no API key for any of these
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
